{
  "name": "nukerat",
  "private": true,
  "version": "1.4.7-alpha",
  "description": "nukerat client",
  "author": "nukerat",
  "desktopName": "com.nukerat.app",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node ./node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "preview": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "lint": "eslint ."
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "dockview": "5.1.0",
    "lucide-react": "0.577.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "react-markdown": "10.1.0",
    "react-simple-code-editor": "^0.14.1",
    "react-virtuoso": "4.18.16",
    "reactflow": "11.11.4",
    "remark-gfm": "^4.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.5",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "^8.3.2"
  },
  "build": {
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appId": "com.nukerat.app",
    "productName": "nukerat",
    "artifactName": "nukerat.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "icon": "public/icon_256x256.png",
    "linux": {
      "target": "AppImage",
      "icon": "public/icon_256x256.png",
      "syncDesktopName": true,
      "desktop": {
        "entry": {
          "StartupWMClass": "com.nukerat.app"
        }
      }
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.svg"
    }
  }
}
